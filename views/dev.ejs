<%- include('partials/header.ejs'); -%>
    <h1>Dev Dashboard</h1>

    <nav class="nav nav-tabs mb-4">
        <a href="/dev" class="nav-link <%= page === 'settlement' ? 'active' : '' %>">Settlement</a>
        <a href="/dev/bugs" class="nav-link <%= page === 'bugs' ? 'active' : '' %>">Bug Reports</a>
        <a href="/dev/suggestions" class="nav-link <%= page === 'suggestions' ? 'active' : '' %>">Gameplay Suggestions</a>
    </nav>

    <% if (page === "settlement") { %>
        <%- include('partials/devPlayerSelector.ejs'); %>

        <% if (stats) { %>
            <%- include('partials/devPlayerStats.ejs'); %>
        <% } %>
    <% } else if (page === "bugs") {%>
        <%- include('partials/devBugReports.ejs'); -%>
    <% } else if (page === "suggestions") {%>
        <%- include('partials/devGameplaySuggestions.ejs'); -%>
    <% } %>

    <%- include('partials/footer.ejs'); -%>
    </body>
</html>