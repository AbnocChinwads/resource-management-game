<script>
    async function checkAnnouncements() {
        try {
            const response = await fetch("/api/announcements", {
                credentials: "include",
            });

            const data = await response.json();

            if (!data.announcements.length) {
                return;
            }

            const announcement = data.announcements[0];

            document.getElementById("announcementTitle").textContent =
                announcement.title;

            document.getElementById("announcementMessage").textContent =
                announcement.message;

            const modal = new bootstrap.Modal(
                document.getElementById("announcementModal")
            );

            modal.show();

            document.getElementById("announcementConfirm").onclick = async () => {
                await fetch(
                    `/api/announcements/${announcement.id}/seen`,
                    {
                        method: "POST",
                        credentials: "include",
                    }
                );

                modal.hide();
            };
        } catch (error) {
            console.error("Announcement check failed: ", err);
        }
    }

    checkAnnouncements();
</script>