<script>
    function startProgressUpdates() {
        function updateProgress() {
            const now = Date.now();
            const bars = document.querySelectorAll(".progress-bar");

            bars.forEach(bar => {
                const startedAt = parseInt(bar.dataset.startedAt);
                const craftTime = parseInt(bar.dataset.craftTime) * 1000;

                if (!startedAt || !craftTime) return;

                let progress = (now - startedAt) / craftTime;
                progress = Math.min(Math.max(progress, 0), 1);

                if (progress >= 1) {
                    bar.style.width = "100%";

                    if (!bar.dataset.completeShown) {
                        bar.dataset.completeShown = "true";

                        setTimeout(() => {
                            const li = bar.closest("li");
                            if (!li) return;

                            const progressContainer = li.querySelector(".progress");
                            const completeContainer = li.querySelector(".complete-container");

                            if (progressContainer) {
                                progressContainer.remove();
                            }

                            if (completeContainer) {
                                completeContainer.style.display = "block";
                            }
                        });
                    }

                    return;
                }

                bar.style.width = `${progress * 100}%`;
            });
        }

        updateProgress();
        window.updateProgressBars = updateProgress;
        setInterval(updateProgress, 250);
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", startProgressUpdates);
    } else {
        startProgressUpdates();
    }
</script>