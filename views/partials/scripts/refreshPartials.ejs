<script>
    async function refreshActiveTasks() {
        const html = await fetch("/partials/manual-tasks", {
            credentials: "include"
        }).then(r => r.text());

        const container = document.getElementById("manual-tasks-container");

        if (container) {
            container.innerHTML = html;

            if (window.updateProgressBars) {
                window.updateProgressBars();
            }
        }
    }

    async function refreshResources() {
        const res = await fetch("/partials/resources", {
            credentials: "include"
        });

        const html = await res.text();

        const container = document.getElementById(
            "resources-container"
        );

        if (container) {
            container.innerHTML = html;
        }
    }

    async function refreshStorage() {
        const res = await fetch("/partials/storage", {
            credentials: "include"
        });

        const html = await res.text();

        const container = document.getElementById(
            "storage-container"
        );

        if (container) {
            container.innerHTML = html;
        }
    }

    async function refreshRecipes() {
        const res = await fetch("/partials/recipes", {
            credentials: "include"
        });

        const html = await res.text();

        const container = document.getElementById(
            "recipes-container"
        );

        if (container) {
            container.innerHTML = html;
        }
    }

    async function refreshPopulationBuildings() {
        const res = await fetch("/partials/population-buildings", {
            credentials: "include"
        });

        const html = await res.text();

        document.getElementById("population-buildings-container").innerHTML = html;
    }

    async function refreshProductionBuildings() {
        const res = await fetch("/partials/production-buildings", {
            credentials: "include"
        });

        const html = await res.text();

        document.getElementById("production-buildings-container").innerHTML = html;
    }
</script>