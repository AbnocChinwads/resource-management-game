<script>
    async function submitFeedback(form, endpoint) {
        const data = Object.fromEntries(
            new FormData(form)
        );

        const response = await fetch(endpoint, {
            method: "POST",
            credentials: "include",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify(data)
        });

        const result = await response.json();

        alert(result.message || result.error);
    }

    document
        .getElementById("bugForm")
        ?.addEventListener("submit", e => {
            e.preventDefault();
            submitFeedback(e.target, "/feedback/bug");
        });

    document
        .getElementById("suggestionForm")
        ?.addEventListener("submit", e => {
            e.preventDefault();
            submitFeedback(e.target, "/feedback/suggestion");
        });
</script>