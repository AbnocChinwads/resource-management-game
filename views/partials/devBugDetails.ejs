<tr>
    <td colspan="7">
        <div id="bug-details-<%= bug.id %>" class="collapse">
            <h6>Description</h6>
            <p>
                <%= bug.description %>
            </p>
            <% if (bug.metadata?.gameState) { %>
                    <div class="mt-3">
                        <details>
                            <summary>Population</summary>
                            <table class="table table-sm table-bordered mb-3">
                            <tbody>
                                <tr>
                                    <th>Population</th>
                                    <td>
                                        <%= bug.metadata.gameState.population %> / <%= bug.metadata.gameState.populationCapacity %>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Historical max</th>
                                    <td>
                                        <%= bug.metadata.gameState.historicalMaxPopulation %>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Population floor</th>
                                    <td>
                                        <%= bug.metadata.gameState.populationFloor %>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Workers</th>
                                    <td>
                                        <%= bug.metadata.gameState.workers %>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Assigned workers</th>
                                    <td>
                                        <%= bug.metadata.gameState.assignedWorkers %>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Available workers</th>
                                    <td>
                                        <%= bug.metadata.gameState.availableWorkers %>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Food surplus started</th>
                                    <td>
                                        <%= bug.metadata.gameState.foodSurplusStartedAt ?? "-" %>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Starvation started</th>
                                    <td>
                                        <%= bug.metadata.gameState.starvationStartedAt ?? "-" %>
                                    </td>
                                </tr>
                            </tbody>
                            </table>
                        </details>
                        <details>
                            <summary>Food</summary>
                            <table class="table table-sm table-bordered mb-3">
                            <tbody>
                                <tr>
                                    <th>Stored</th>
                                    <td>
                                        <%= bug.metadata.gameState.food %>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Required / min</th>
                                    <td>
                                        <%= bug.metadata.gameState.foodRequiredPerMinute %>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Supplied / min</th>
                                    <td>
                                        <%= bug.metadata.gameState.foodSuppliedPerMinute %>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Net / min</th>
                                    <td>
                                        <%= bug.metadata.gameState.foodNetFlowPerMinute %>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Potential / min</th>
                                    <td>
                                        <%= bug.metadata.gameState.foodPotentialBalancePerMinute %>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Population growth interval</th>
                                    <td>
                                        <%= bug.metadata.gameState.populationGrowthSeconds %> seconds
                                    </td>
                                </tr>
                                <tr>
                                    <th>Starvation interval</th>
                                    <td>
                                        <%= bug.metadata.gameState.starvationConsequenceSeconds %> seconds
                                    </td>
                                </tr>
                                <tr>
                                    <th>Surplus started</th>
                                    <td>
                                        <%= bug.metadata.gameState.foodSurplusStartedAt ?? "-" %>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Starvation started</th>
                                    <td>
                                        <%= bug.metadata.gameState.starvationStartedAt ?? "-" %>
                                    </td>
                                </tr>
                            </tbody>
                            </table>
                        </details>
                        <details>
                            <summary>Resources</summary>
                            <table class="table table-sm table-striped table-bordered mb-3">
                            <thead>
                                <tr>
                                    <th>Resource</th>
                                    <th>Amount</th>
                                    <th>Produced / min</th>
                                    <th>Consumed / min</th>
                                    <th>Net / min</th>
                                    <th>Category</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% bug.metadata.gameState.resources.forEach(resource=> { %>
                                    <tr>
                                        <td>
                                            <%= resource.name %>
                                        </td>
                                        <td>
                                            <%= resource.amount %>
                                        </td>
                                        <td>
                                            <%= resource.producedPerMinute %>
                                        </td>
                                        <td>
                                            <%= resource.consumedPerMinute %>
                                        </td>
                                        <td>
                                            <%= resource.netPerMinute %>
                                        </td>
                                        <td>
                                            <%= resource.storageCategory %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                            </table>
                        </details>
                        <details>
                            <summary>Buildings</summary>
                            <table class="table table-sm table-striped table-bordered mb-3">
                            <thead>
                                <tr>
                                    <th>Building</th>
                                    <th>Type</th>
                                    <th>Workers</th>
                                    <th>Production</th>
                                    <th>Output</th>
                                    <th>Status</th>
                                    <th>Reason</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% bug.metadata.gameState.buildings.forEach(building=> { %>
                                    <tr>
                                        <td>
                                            <%= building.name %> #<%= building.building_number %>
                                        </td>
                                        <td>
                                            <%= building.type %>
                                        </td>
                                        <td>
                                            <%= building.workers_assigned %> / <%= building.max_workers %>
                                        </td>
                                        <td>
                                            <%= building.productionRate %> / min
                                        </td>
                                        <td>
                                            <%= building.output_resource_name ?? "-" %>
                                        </td>
                                        <td>
                                            <%= building.productionStatus?.status ?? "-" %>
                                        </td>
                                        <td>
                                            <%= building.productionStatus?.reason ?? "-" %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                            </table>
                        </details>
                        <details>
                            <summary>Building Inputs</summary>
                            <table class="table table-sm table-striped table-bordered mb-3">
                            <thead>
                                <tr>
                                    <th>Building</th>
                                    <th>Input</th>
                                    <th>Amount / cycle</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% bug.metadata.gameState.buildings.forEach(building=> { %> 
                                    <% building.consumptionRates.forEach(input=> { %> 
                                        <tr>
                                            <td>
                                                <%= building.name %> #<%= building.building_number %>
                                            </td>
                                            <td>
                                                <%= input.name %>
                                            </td>
                                            <td>
                                                <%= input.amount %>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% }) %>
                            </tbody>
                            </table>
                        </details>
                        <details>
                            <summary>Storage</summary>
                            <table class="table table-sm table-striped table-bordered">
                            <thead>
                                <tr>
                                    <th>Category</th>
                                    <th>Used</th>
                                    <th>Capacity</th>
                                    <th>Available</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% bug.metadata.gameState.storage.forEach(storage=> { %>
                                    <tr>
                                       <td>
                                           <%= storage.storage_category %>
                                       </td>
                                       <td>
                                           <%= storage.used %>
                                       </td>
                                       <td>
                                           <%= storage.capacity %>
                                       </td>
                                       <td>
                                           <%= Number(storage.capacity) - Number(storage.used) %>
                                       </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                            </table>
                        </details>
                    </div>
            <% } else { %> - <% } %>
        </div>
    </td>
</tr>