<div class="row">
    <div class="col-lg-4">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Population</h5>
            </div>
            <div class="card-body">
                <ul class="list-group">
                    <li class="list-group-item">
                        Population: <%= stats.population %>
                    </li>
                    <li class="list-group-item">
                        Workers: <%= stats.workers %>
                    </li>
                    <li class="list-group-item">
                        Assigned Workers: <%= stats.assignedWorkers %>
                    </li>
                    <li class="list-group-item">
                        Available Workers: <%= stats.availableWorkers %>
                    </li>
                </ul>
            </div>
        </div>
    </div>