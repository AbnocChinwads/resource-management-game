<!-- ===========================
     1. Game Actions
=========================== -->
<script>
    window.changeWorkers = async function (buildingId, delta) {
        try {
            const res = await fetch("/update-workers", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                credentials: "include",
                body: JSON.stringify({ buildingId, delta })
            });

            const data = await res.json();
            if (data.success) {
                document.getElementById(`building-${buildingId}-workers`).textContent = data.workers_assigned;
                const availEl = document.getElementById("available-workers");
                if (availEl) availEl.textContent = data.availableWorkers;
            } else {
                alert(data.error || "Cannot change workers");
            }
        } catch (err) {
            console.error("Worker assignment error:", err);
        }
    };

    // Complete task handler
    document.body.addEventListener("submit", async (e) => {
        const form = e.target;

        if (!form.matches(".complete-form")) return;

        e.preventDefault();

        const formData = new FormData(form);
        const taskId = formData.get("taskId");

        try {
            const res = await fetch("/complete-task", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                credentials: "include",
                body: JSON.stringify({ taskId })
            });

            const data = await res.json();

            if (data.success) {
                // Reload to fetch updated tasks/resources
                await updateStats();
            } else {
                console.error(data.error);
            }
        } catch (err) {
            console.error("Complete task error:", err);
        }
    });

    async function refreshActiveTasks() {
        const html = await fetch("/partials/manual-tasks", {
            credentials: "include"
        }).then(r => r.text());

        const container = document.getElementById("manual-tasks-container");

        if (container) {
            container.innerHTML = html;

            if (window.updateProgressBars) {
                window.updateProgressBars();
            }
        }
    }

    async function refreshRecipes() {
        // Remember open accordion sections
        const openRecipes = [
            ...document.querySelectorAll("#recipeAccordion .accordion-collapse.show")
        ].map(el => el.id);

        const res = await fetch("/partials/recipes", {
            credentials: "include"
        });

        const html = await res.text();

        document.getElementById("recipes-container").innerHTML = html;

        // Restore open sections
        
openRecipes.forEach(id => {
    const collapse = document.getElementById(id);

    if (!collapse) return;

    bootstrap.Collapse.getOrCreateInstance(collapse).show();
});

    async function refreshBuildings() {
        const res = await fetch("/partials/populationbuildings", "/partials/productionbuildings", {
            credentials: "include"
        });

        const html = await res.text();

        document.getElementById("buildings-container").innerHTML = html;
    }
</script>

<!-- ===========================
     2. Live Stats / Progress
=========================== -->
<script>
    let lastTaskState = null;
    let lastRecipeState = null;
    let progressInterval;

    /*========================
        FORMATTING HELPERS
    ========================*/
    function formatResourceAmount(amount) {
        return Number(amount).toFixed(2).replace(/\.?0+$/, "");
    }

    function updateNetFlowElement(element, amount) {
        const value = Number(amount);

        element.classList.remove("text-success", "text-danger", "text-muted");

        if (value > 0) {
            element.innerHTML = `<span aria-hidden="true">▲</span><span class="visually-hidden">Increasing by</span> ${value.toFixed(1)}/min<span class="visually-hidden">per minute</span>`;
            element.classList.add("text-success");
        } else if (value < 0) {
            element.innerHTML = `<span aria-hidden="true">▼</span><span class="visually-hidden">Decreasing by</span> ${Math.abs(value).toFixed(1)}/min<span class="visually-hidden">per minute</span>`;
            element.classList.add("text-danger");
        } else {
            element.innerHTML = `<span aria-hidden="true">—</span><span class="visually-hidden">No change</span> 0/min <span class="visually-hidden">per minute</span>`;
            element.classList.add("text-muted");
        }
    }

    function updateProductionElement(element, building) {
        const value = Number(building.productionRate ?? 0);

        element.classList.remove("text-success", "text-danger", "text-muted");

        if (value > 0) {
            element.innerHTML = `<span aria-hidden="true">▲</span><span class="visually-hidden">Increasing by</span> ${building.output_resource_name} ${value.toFixed(1)}/min<span class="visually-hidden">per minute</span>`;
            element.classList.add("text-success");
        } else if (value < 0) {
            element.innerHTML = `<span aria-hidden="true">▼</span><span class="visually-hidden">Decreasing by</span> ${building.output_resource_name} ${Math.abs(value).toFixed(1)}/min<span class="visually-hidden">per minute</span>`;
            element.classList.add("text-danger");
        } else {
            element.innerHTML = `<span aria-hidden="true">—</span><span class="visually-hidden">Not producing</span> 0/min`;
            element.classList.add("text-muted");
        }
    }

    function updateConsumptionElement(element, building) {
        element.classList.remove(
            "text-danger",
            "text-muted"
        );

        if (!building.consumptionRates ||
            building.consumptionRates.length === 0 || building.workers_assigned === 0) {

            element.innerHTML = `<span aria-hidden="true">—</span><span class="visually-hidden">No inputs</span>`;
            element.classList.add("text-muted");
            return;
        }

        element.innerHTML = building.consumptionRates.map(input => `<span aria-hidden="true">▼</span><span class="visually-hidden">Consuming </span>${input.name} ${Number(input.amount).toFixed(1)} <span class="visually-hidden">per minute</span>`).join("<br>");
        element.classList.add("text-danger");
    }

    /*========================
        FORMATTING HELPERS
    ========================*/

    async function updateStats() {
        try {
            const res = await fetch("/api/player-stats", { credentials: "include" });
            const data = await res.json();

            document.getElementById("population-count").textContent = data.population;
            document.getElementById("worker-count").textContent = data.workers;
            document.getElementById("assigned-worker-count").textContent = data.assignedWorkers;
            document.getElementById("available-workers").textContent = data.availableWorkers;
            document.getElementById("food-count").textContent = Number(data.food ?? 0).toFixed(1);

            const foodConsumptionEl = document.getElementById("food-consumption");

            if (foodConsumptionEl) {
                foodConsumptionEl.textContent =
                    `${Number(data.foodConsumptionRate ?? 0).toFixed(1)}/min`;
            }

            // Update player resources
            data.resources.forEach(r => {
                const amountEl = document.getElementById(`resource-${r.resource_type_id}`);
                const netEl = document.getElementById(`resource-${r.resource_type_id}-net`);

                if (amountEl) {
                    amountEl.textContent = formatResourceAmount(r.amount);
                }

                if (netEl) {
                    updateNetFlowElement(netEl, r.netPerMinute);
                }
            });

            //Update player buildings
            if (data.buildings) {
                data.buildings.forEach(b => {
                    const productionEl = document.getElementById(`building-${b.id}-production`);
                    const consumptionEl = document.getElementById(`building-${b.id}-consumption`);

                    if (productionEl) {
                        updateProductionElement(productionEl, b);
                    }

                    if (consumptionEl) {
                        updateConsumptionElement(consumptionEl, b);
                    }
                });
            }

            // Update building workers
            data.buildings.forEach(b => {
                const el = document.getElementById(`building-${b.id}-workers`);
                if (el) el.textContent = b.workers_assigned;
            });

            const taskState = JSON.stringify(data.tasks);

            if (taskState !== lastTaskState) {
                lastTaskState = taskState;
                await refreshActiveTasks();
            }

            const recipeState = JSON.stringify({
                resources: data.resources.map(r => ({
                    id: r.resource_type_id,
                    amount: r.amount
                })),
                buildings: data.buildings.map(b => ({
                    id: b.building_id
                }))
            });

            if (recipeState !== lastRecipeState) {
                lastRecipeState = recipeState;
                await refreshRecipes();
            }
            await refreshBuildings();
        } catch (err) {
            console.error("Stats update error:", err);
        }
    }

    // Poll every 3 seconds
    setInterval(updateStats, 3000);
    updateStats(); // initial call

    function startProgressUpdates() {
        function updateProgress() {
            const now = Date.now();
            const bars = document.querySelectorAll(".progress-bar");

            bars.forEach(bar => {
                const startedAt = parseInt(bar.dataset.startedAt);
                const craftTime = parseInt(bar.dataset.craftTime) * 1000;

                if (!startedAt || !craftTime) return;

                let progress = (now - startedAt) / craftTime;
                progress = Math.min(Math.max(progress, 0), 1);

                if (progress >= 1) {
                    bar.style.width = "100%";

                    if (!bar.dataset.completeShown) {
                        bar.dataset.completeShown = "true";

                        setTimeout(() => {
                            const li = bar.closest("li");
                            if (!li) return;

                            const progressContainer = li.querySelector(".progress");
                            const completeContainer = li.querySelector(".complete-container");

                            if (progressContainer) {
                                progressContainer.remove();
                            }

                            if (completeContainer) {
                                completeContainer.style.display = "block";
                            }
                        });
                    }

                    return;
                }

                bar.style.width = `${progress * 100}%`;
            });
        }

        updateProgress();
        window.updateProgressBars = updateProgress;
        setInterval(updateProgress, 250);
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", startProgressUpdates);
    } else {
        startProgressUpdates();
    }
</script>