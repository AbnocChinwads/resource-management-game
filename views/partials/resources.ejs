<!-- Stats display -->
<div class="table-responsive">
    <h2>Resource</h2>
    <table class="table table-sm align-middle table-striped-columns table-hover table-bordered">
        <thead>
            <tr>
                <th>Resource</th>
                <th>Current</th>
                <th>Flow</th>
            </tr>
        </thead>
        <tbody id="resource-table-body">
        </tbody>
    </table>
</div>
<!-- Pop Display -->
<div class="table-responsive">
    <h2 class="mt-3">Population</h2>
    <table class="table table-sm align-middle table-striped-columns table-hover table-bordered">
        <thead>
            <tr>
                <th>Current / Max</th>
                <th>Workers</th>
                <th>Idle / Assigned</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td id="population-current-max"></td>
                <td id="worker-count"></td>
                <td id="idle-vs-assigned-workers"></td>
            </tr>
        </tbody>
    </table>
</div>
<!-- Food Display -->
<div class="table-responsive">
    <h2 class="mt-3">Food</h2>
    <table class="table table-sm align-middle table-striped-columns table-hover table-bordered">
        <thead>
            <tr>
                <th>Food</th>
                <th>Supply / Demand</th>
                <th>Balance</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td id="food-count"></td>
                <td id="player-food-supply-demand"></td>
                <td id="player-food-net"></td>
            </tr>
        </tbody>
    </table>
</div>