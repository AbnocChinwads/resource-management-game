<!-- Stats display -->
<div class="table-responsive">
    <h2>Resource</h2>
    <table class="table table-sm align-middle table-striped-columns table-hover table-bordered">
        <thead>
            <tr>
                <th>Resource</th>
                <th>Current</th>
                <th>Flow</th>
            </tr>
        </thead>
        <tbody id="resource-table-body">
        </tbody>
    </table>
</div>
<!-- Pop Display -->
<div class="table-responsive">
    <h2 class="mt-3">Population</h2>
    <table class="table table-sm align-middle table-striped-columns table-hover table-bordered">
        <thead>
            <tr>
                <th>Pop.</th>
                <th>Workers</th>
                <th>Idle</th>
                <th class="d-none d-xxl-table-cell">Assigned</th>
                <th class="d-none d-xxl-table-cell">Food</th>
                <th>Food Req.</th>
                <th class="d-none d-xxl-table-cell">Supplied</th>
                <th>Balance</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td id="population-count"></td>
                <td id="worker-count"></td>
                <td id="available-workers"></td>
                <td class="d-none d-xxl-table-cell" id="assigned-worker-count"></td>
                <td class="d-none d-xxl-table-cell" id="food-count"></td>
                <td id="player-food-required"></td>
                <td class="d-none d-xxl-table-cell" id="player-food-supplied"></td>
                <td id="player-food-net"></td>
            </tr>
        </tbody>
    </table>
</div>