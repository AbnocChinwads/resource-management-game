<!-- Stats display -->
<div class="table-responsive">
    <h2>Resources</h2>
    <table class="table table-sm align-middle table-striped-columns table-hover table-bordered">
        <thead>
            <tr>
                <th>Resource</th>
                <th>Amount</th>
                <th>Flow</th>
            </tr>
        </thead>
        <tbody>
            <% resources.forEach(resource=> { %>
                <tr>
                    <td><%= resource.name %></td>
                    <td id="resource-<%= resource.resource_type_id %>"></td>
                    <td id="resource-<%= resource.resource_type_id %>-net" aria-live="polite"></td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</div>
<!-- Pop Display -->
<div class="table-responsive">
    <h2 class="mt-3">Population</h2>
    <table class="table table-sm align-middle table-striped-columns table-hover table-bordered">
        <thead>
            <tr>
                <th>Population</th>
                <th>Workers</th>
                <th>Available Workers</th>
                <th>Assigned Workers</th>
                <th>Food Stored</th>
                <th>Food Consumed</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td id="population-count"></td>
                <td id="worker-count"></td>
                <td id="available-workers"></td>
                <td id="assigned-worker-count"></td>
                <td id="food-count"></td>
                <td id="food-consumption"></td>
            </tr>
        </tbody>
    </table>
</div>