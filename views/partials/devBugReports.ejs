<div class="card mb-4">
    <div class="card-header">
        <h5 class="mb-0">Bug Reports</h5>
    </div>
    <div class="card-body table-responsive">
        <% if (bugs.length===0) { %>
            <p>No bug reports submitted.</p>
            <% } else { %>
                <table class="table table-sm table-striped table-hover table-bordered">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Description</th>
                            <th>Player</th>
                            <th>Page</th>
                            <th>Status</th>
                            <th>Priority</th>
                            <th>Reported</th>
                            <th>Diagnostics</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% bugs.forEach(bug=> { %> <tr>
                                <td>
                                    <%= bug.title %>
                                </td>
                                <td>
                                    <%= bug.description %>
                                </td>
                                <td>
                                    <% if (bug.player_id) { %> <a href="/dev?player=<%= bug.player_id %>">
                                            <%= bug.player_name %>
                                        </a>
                                        <% } else { %> Unknown <% } %>
                                </td>
                                <td>
                                    <%= bug.page ?? "-" %>
                                </td>
                                <td> <label class="visually-hidden" for="bug-status-<%= bug.id %>"> Status for <%=
                                            bug.title %> </label> <select id="bug-status-<%= bug.id %>" name="status"
                                        form="bug-form-<%= bug.id %>" class="form-select form-select-sm">
                                        <option value="open" <%=bug.status==="open" ? "selected" : "" %>> Open </option>
                                        <option value="in_progress" <%=bug.status==="in_progress" ? "selected" : "" %>>
                                            In Progress </option>
                                        <option value="resolved" <%=bug.status==="resolved" ? "selected" : "" %>>
                                            Resolved </option>
                                        <option value="wont_fix" <%=bug.status==="wont_fix" ? "selected" : "" %>> Won't
                                            Fix </option>
                                    </select> </td>
                                <td> <label class="visually-hidden" for="bug-priority-<%= bug.id %>"> Priority for <%=
                                            bug.title %> </label> <select id="bug-priority-<%= bug.id %>"
                                        name="priority" form="bug-form-<%= bug.id %>"
                                        class="form-select form-select-sm">
                                        <option value="low" <%=bug.priority==="low" ? "selected" : "" %>> Low </option>
                                        <option value="medium" <%=bug.priority==="medium" ? "selected" : "" %>> Medium
                                        </option>
                                        <option value="high" <%=bug.priority==="high" ? "selected" : "" %>> High
                                        </option>
                                        <option value="critical" <%=bug.priority==="critical" ? "selected" : "" %>>
                                            Critical </option>
                                    </select> </td>
                                <td>
                                    <%= new Date(bug.created_at).toLocaleString("en-GB") %>
                                </td>
                                <td>
                                    <% if (bug.metadata?.gameState) { %>
                                        <details>
                                            <summary>View snapshot</summary>
                                            <div class="mt-3">
                                                <h6>Population</h6>
                                                <table class="table table-sm table-bordered mb-3">
                                                    <tbody>
                                                        <tr>
                                                            <th>Population</th>
                                                            <td>
                                                                <%= bug.metadata.gameState.population %> / <%=
                                                                        bug.metadata.gameState.populationCapacity %>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <th>Historical max</th>
                                                            <td>
                                                                <%= bug.metadata.gameState.historicalMaxPopulation %>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <th>Population floor</th>
                                                            <td>
                                                                <%= bug.metadata.gameState.populationFloor %>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <th>Workers</th>
                                                            <td>
                                                                <%= bug.metadata.gameState.workers %>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <th>Assigned workers</th>
                                                            <td>
                                                                <%= bug.metadata.gameState.assignedWorkers %>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <th>Available workers</th>
                                                            <td>
                                                                <%= bug.metadata.gameState.availableWorkers %>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <th>Food surplus started</th>
                                                            <td>
                                                                <%= bug.metadata.gameState.foodSurplusStartedAt ?? "-"
                                                                    %>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <th>Starvation started</th>
                                                            <td>
                                                                <%= bug.metadata.gameState.starvationStartedAt ?? "-" %>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                                <h6>Food</h6>
                                                <table class="table table-sm table-bordered mb-3">
                                                    <tbody>
                                                        <tr>
                                                            <th>Stored</th>
                                                            <td>
                                                                <%= bug.metadata.gameState.food %>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <th>Required / min</th>
                                                            <td>
                                                                <%= bug.metadata.gameState.foodRequiredPerMinute %>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <th>Supplied / min</th>
                                                            <td>
                                                                <%= bug.metadata.gameState.foodSuppliedPerMinute %>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <th>Net / min</th>
                                                            <td>
                                                                <%= bug.metadata.gameState.foodNetFlowPerMinute %>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <th>Potential / min</th>
                                                            <td>
                                                                <%= bug.metadata.gameState.foodPotentialBalancePerMinute
                                                                    %>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <th>Population growth interval</th>
                                                            <td>
                                                                <%= bug.metadata.gameState.populationGrowthSeconds %>
                                                                    seconds
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <th>Starvation interval</th>
                                                            <td>
                                                                <%= bug.metadata.gameState.starvationConsequenceSeconds
                                                                    %> seconds
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <th>Surplus started</th>
                                                            <td>
                                                                <%= bug.metadata.gameState.foodSurplusStartedAt ?? "-"
                                                                    %>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <th>Starvation started</th>
                                                            <td>
                                                                <%= bug.metadata.gameState.starvationStartedAt ?? "-" %>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                                <h6>Resources</h6>
                                                <table class="table table-sm table-striped table-bordered mb-3">
                                                    <thead>
                                                        <tr>
                                                            <th>Resource</th>
                                                            <th>Amount</th>
                                                            <th>Produced / min</th>
                                                            <th>Consumed / min</th>
                                                            <th>Net / min</th>
                                                            <th>Category</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <% bug.metadata.gameState.resources.forEach(resource=> { %> <tr>
                                                                <td>
                                                                    <%= resource.name %>
                                                                </td>
                                                                <td>
                                                                    <%= resource.amount %>
                                                                </td>
                                                                <td>
                                                                    <%= resource.producedPerMinute %>
                                                                </td>
                                                                <td>
                                                                    <%= resource.consumedPerMinute %>
                                                                </td>
                                                                <td>
                                                                    <%= resource.netPerMinute %>
                                                                </td>
                                                                <td>
                                                                    <%= resource.storageCategory %>
                                                                </td>
                                                            </tr>
                                                            <% }) %>
                                                    </tbody>
                                                </table>
                                                <h6>Buildings</h6>
                                                <table class="table table-sm table-striped table-bordered mb-3">
                                                    <thead>
                                                        <tr>
                                                            <th>Building</th>
                                                            <th>Type</th>
                                                            <th>Workers</th>
                                                            <th>Production</th>
                                                            <th>Output</th>
                                                            <th>Status</th>
                                                            <th>Reason</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <% bug.metadata.gameState.buildings.forEach(building=> { %> <tr>
                                                                <td>
                                                                    <%= building.name %> #<%= building.building_number
                                                                            %>
                                                                </td>
                                                                <td>
                                                                    <%= building.type %>
                                                                </td>
                                                                <td>
                                                                    <%= building.workers_assigned %> / <%=
                                                                            building.max_workers %>
                                                                </td>
                                                                <td>
                                                                    <%= building.productionRate %> / min
                                                                </td>
                                                                <td>
                                                                    <%= building.output_resource_name ?? "-" %>
                                                                </td>
                                                                <td>
                                                                    <%= building.productionStatus?.status ?? "-" %>
                                                                </td>
                                                                <td>
                                                                    <%= building.productionStatus?.reason ?? "-" %>
                                                                </td>
                                                            </tr>
                                                            <% }) %>
                                                    </tbody>
                                                </table>
                                                <h6>Building Inputs</h6>
                                                <table class="table table-sm table-striped table-bordered mb-3">
                                                    <thead>
                                                        <tr>
                                                            <th>Building</th>
                                                            <th>Input</th>
                                                            <th>Amount / cycle</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <% bug.metadata.gameState.buildings.forEach(building=> { %> <%
                                                                building.consumptionRates.forEach(input=> { %> <tr>
                                                                    <td>
                                                                        <%= building.name %> #<%=
                                                                                building.building_number %>
                                                                    </td>
                                                                    <td>
                                                                        <%= input.name %>
                                                                    </td>
                                                                    <td>
                                                                        <%= input.amount %>
                                                                    </td>
                                                                </tr>
                                                                <% }) %>
                                                                    <% }) %>
                                                    </tbody>
                                                </table>
                                                <h6>Storage</h6>
                                                <table class="table table-sm table-striped table-bordered">
                                                    <thead>
                                                        <tr>
                                                            <th>Category</th>
                                                            <th>Used</th>
                                                            <th>Capacity</th>
                                                            <th>Available</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <% bug.metadata.gameState.storage.forEach(storage=> { %> <tr>
                                                                <td>
                                                                    <%= storage.storage_category %>
                                                                </td>
                                                                <td>
                                                                    <%= storage.used %>
                                                                </td>
                                                                <td>
                                                                    <%= storage.capacity %>
                                                                </td>
                                                                <td>
                                                                    <%= Number(storage.capacity) - Number(storage.used)
                                                                        %>
                                                                </td>
                                                            </tr>
                                                            <% }) %>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </details>
                                        <% } else { %> - <% } %>
                                </td>
                                <td>
                                    <form id="bug-form-<%= bug.id %>" method="POST" action="/dev/bugs/<%= bug.id %>">
                                        <button type="submit" class="btn btn-sm btn-primary"> Update </button> </form>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
                <% } %>
    </div>
</div>